# scripts/install-windows.ps1 and scripts/start-3100.ps1 manage these automatically.
# Set only when running Node commands manually. Never commit real credentials.
LUMA_DATA_ROOT=./data
LUMA_RUNTIME_ROOT=./.runtime
# LUMA_ADMIN_PASSWORD is used only for first initialization (minimum 12 chars).
# LUMA_CREDENTIAL_ENCRYPTION_KEY must be loaded from YOUR data/system key file.
# LUMA_SECURE_COOKIES=0 is for local HTTP; HTTPS hosting requires 1.
